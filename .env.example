# Copy to `.env` and fill in. `.env` is gitignored.
#
# `docker compose` automatically reads `.env` from the project root before
# substituting `${VAR}` in `docker-compose.yml`.

# Your MeshCore device's TCP companion endpoint. Defaults in docker-compose.yml
# fall back to the LilyGo T3-S3 WiFi-firmware default (192.168.4.1:5000) — override
# here if your device is elsewhere on the LAN.
# MESHCORE_HOST=192.168.4.1
# MESHCORE_PORT=5000

# Required when bearer-token auth is enabled (defense in depth behind your
# reverse proxy). Generate one with: openssl rand -hex 32
# Leave commented to run open (LAN-trust model only).
# MESHCORE_WEBUI_API_KEY=

# Web Push abuse-contact email. Required by the Web Push spec; some push
# services (Apple/Google/Mozilla) log it for abuse contact. Use a real address.
# VAPID_SUBJECT=mailto:you@example.com

# Optional — embeds the VAPID public key into the bundled JS at build time so
# the first push subscription skips a runtime fetch. The runtime fallback at
# /api/push/vapid-public-key works without this, so it is purely an
# optimisation. Read from backend/secrets/vapid_public.txt after running the
# `Quickstart › Generate a VAPID keypair` step.
# VITE_VAPID_PUBLIC_KEY=
